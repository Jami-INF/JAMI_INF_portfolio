---
import { NAV, SITE } from '../consts';

// Normalise le chemin courant pour l'état actif (sans slash final).
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const clean = href.replace(/\/+$/, '') || '/';
  return clean === '/' ? path === '/' : path === clean || path.startsWith(clean + '/');
};
---

<header class="border-b-2 border-line bg-bg sticky top-0 z-50">
  <nav
    aria-label="Navigation principale"
    class="mx-auto flex max-w-6xl items-stretch justify-between"
  >
    <a
      href="/"
      class="flex items-center gap-2 border-r-2 border-line px-4 py-4 font-display text-lg font-bold uppercase tracking-tight transition-colors duration-150 hover:bg-accent hover:text-accent-ink"
    >
      <span aria-hidden="true" class="font-mono text-accent-ink bg-ink text-bg px-1.5 py-0.5 text-sm">JI</span>
      <span>{SITE.name}</span>
    </a>

    <ul class="flex items-stretch">
      {
        NAV.filter((item) => item.href !== '/').map((item) => (
          <li class="flex">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'flex items-center border-l-2 border-line px-3 sm:px-5 font-mono text-xs sm:text-sm uppercase tracking-wide transition-colors duration-150 hover:bg-accent hover:text-accent-ink',
                isActive(item.href) && 'bg-ink text-bg',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }

      <li class="flex">
        <button
          type="button"
          id="theme-toggle"
          aria-label="Basculer entre le thème clair et sombre"
          class="flex items-center border-l-2 border-line px-3 sm:px-4 transition-colors duration-150 hover:bg-accent hover:text-accent-ink"
        >
          {/* Lune */}
          <svg
            class="theme-icon-moon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          {/* Soleil */}
          <svg
            class="theme-icon-sun"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  const meta = document.querySelector('meta[name="theme-color"]');
  const colors = { light: '#efece1', dark: '#16150f' };

  const apply = (theme: string) => {
    document.documentElement.dataset.theme = theme;
    if (meta) meta.setAttribute('content', colors[theme as keyof typeof colors]);
    btn?.setAttribute('aria-pressed', String(theme === 'dark'));
  };

  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    localStorage.setItem('theme', next);
    apply(next);
  });

  // Synchronise l'état initial du bouton avec le thème déjà posé par Base.astro.
  apply(document.documentElement.dataset.theme || 'light');
</script>
